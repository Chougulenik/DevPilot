# ==============================================================================
# Enterprise RAG Platform - Environment Variables Template
# Copy this file to '.env' in the project root: cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. API Keys & LLM Providers (Google AI Studio / Gemini)
# ------------------------------------------------------------------------------
# Free API key from https://aistudio.google.com/
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Cohere API key (Optional: Used for Cohere Cross-Encoder Reranking in the Playground)
COHERE_API_KEY=your_cohere_api_key_here

# ------------------------------------------------------------------------------
# 2. Vector Database & Storage Paths
# ------------------------------------------------------------------------------
# Local directory where ChromaDB stores persistent embeddings and collections
CHROMA_PERSIST_DIR=db/chroma_db

# Local directory containing source documents (.txt, .md, .pdf) for batch re-indexing
DOCS_DIR=docs

# ------------------------------------------------------------------------------
# 3. Model Configuration Defaults (Google Gemini)
# ------------------------------------------------------------------------------
# Embedding model name from Google AI Studio (fast & free)
EMBEDDING_MODEL=models/gemini-embedding-001

# Primary reasoning LLM for grounded answer synthesis and citations
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Faster LLM for multi-turn query rewriting and agentic chunking
FAST_LLM_MODEL=gemini-1.5-flash

# Default temperature for answer generation (0.0 to 1.0)
DEFAULT_TEMPERATURE=0.2

# Default top-k chunks to retrieve per search pass
DEFAULT_K=4

# Default chunking parameters
DEFAULT_CHUNK_SIZE=1000
DEFAULT_CHUNK_OVERLAP=100

# ------------------------------------------------------------------------------
# 4. Server & Application Metadata
# ------------------------------------------------------------------------------
APP_NAME=Enterprise RAG Platform
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# API Prefix
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated list or JSON array: ["*"] or *)
CORS_ORIGINS=["*"]
